{
  "name": "game-name-radar",
  "version": "1.2.0",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vercel dev",
    "scan": "node scripts/scan.mjs",
    "classify": "node scripts/classify-site-types.mjs",
    "test": "node --test tests/*.test.mjs",
    "test:frozen": "node --import ./tools/freeze-time.mjs --test tests/*.test.mjs",
    "verify:sources": "node tools/verify-sources.mjs",
    "probe:source": "node tools/probe-source.mjs",
    "check": "node --check app.js && node --check api/scan.js && npm test"
  },
  "dependencies": {
    "google-trends-api": "4.9.2"
  },
  "engines": {
    "node": ">=20"
  }
}
